[data-theme="mint"] .form-input,
[data-theme="lavender"] .form-input,
[data-theme="snow"] .form-input{background:rgba(0,0,0,0.03);color:var(--text)}

/* ★ TabBar 无毛玻璃模糊 */
[data-theme="dawn"] .tab-bar,
[data-theme="mint"] .tab-bar,
[data-theme="lavender"] .tab-bar,
[data-theme="snow"] .tab-bar{backdrop-filter:none;-webkit-backdrop-filter:none;background:var(--bar-bg);box-shadow:0 -2rpx 8rpx rgba(0,0,0,0.04)}
[data-theme="dawn"] .tab-item.active .tab-icon,
[data-theme="mint"] .tab-item.active .tab-icon,
[data-theme="lavender"] .tab-item.active .tab-icon,
[data-theme="snow"] .tab-item.active .tab-icon{filter:none}

/* ★ AI计划：纯色 */
[data-theme="dawn"] .ai-plan,
[data-theme="mint"] .ai-plan,
[data-theme="lavender"] .ai-plan,
[data-theme="snow"] .ai-plan{background:#f8f8f8}

/* ★ 主按钮：纯色（无渐变） */
[data-theme="dawn"] .btn-primary,
[data-theme="mint"] .btn-primary,
[data-theme="lavender"] .btn-primary,
[data-theme="snow"] .btn-primary{background:var(--accent);box-shadow:0 2rpx 12rpx rgba(0,0,0,0.12)}

/* ★ 装备槽 */
