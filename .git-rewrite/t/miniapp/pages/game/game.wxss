[data-theme="snow"] .equip-slot{background:#fff;box-shadow:0 2rpx 8rpx rgba(0,0,0,0.04)}

/* ★ 菜品行 */
[data-theme="dawn"] .menu-row,
[data-theme="mint"] .menu-row,
