[data-theme="snow"] .menu-row{background:#fff}

/* ★ 成就槽 */
[data-theme="dawn"] .ach-slot,
[data-theme="mint"] .ach-slot,
[data-theme="lavender"] .ach-slot,
[data-theme="snow"] .ach-slot{background:#fff;box-shadow:0 2rpx 8rpx rgba(0,0,0,0.04)}

/* ★ 状态条底色 */
[data-theme="dawn"] .stat-bar,
[data-theme="mint"] .stat-bar,
[data-theme="lavender"] .stat-bar,
[data-theme="snow"] .stat-bar{background:rgba(0,0,0,0.06)}
[data-theme="dawn"] .attr-bar,
[data-theme="mint"] .attr-bar,
[data-theme="lavender"] .attr-bar,
[data-theme="snow"] .attr-bar{background:rgba(0,0,0,0.06)}

/* ===== 基础布局 ===== */
page {
  font-family:-apple-system,'PingFang SC','Microsoft YaHei',sans-serif;
  background:#0a0e1a;
}
/* Flexbox 固定布局：100vh = nav-bar + 可滚动内容区 + tab-bar */
.app{width:100%;height:100vh;display:flex;flex-direction:column;overflow:hidden;background:var(--bg1);color:var(--text)}
/* 内容区域：占据剩余高度，内部 scroll-view 填充 */
.app-body{flex:1;overflow:hidden;position:relative}
/* scroll-view 必须设置显式高度才能滚动 */
.page-scroll{height:100%}
/* scroll-view 内边距（底部留出 tab-bar 空间） */
.page-inner{padding:0 28rpx 140rpx;min-height:100%}

/* ===== 粒子画布 ===== */
.particles-canvas{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:0}

/* ===== 自定义导航栏 ===== */
.nav-bar{position:fixed;top:0;left:0;width:100%;z-index:100;background:var(--bar-bg);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)}
.nav-content{display:flex;align-items:center;justify-content:space-between;height:96rpx;padding:0 24rpx}
.nav-left{display:flex;align-items:center;gap:16rpx}
.back-btn{width:72rpx;height:72rpx;border-radius:50%;border:3rpx solid var(--accent);display:flex;align-items:center;justify-content:center;font-size:44rpx;color:var(--accent);font-weight:300;line-height:1}
.nav-title{font-size:36rpx;font-weight:800;color:var(--accent);letter-spacing:2rpx;position:absolute;left:50%;transform:translateX(-50%)}
.nav-right{display:flex;gap:16rpx;align-items:center;margin-left:auto}
.avatar-frame{width:72rpx;height:72rpx;border-radius:50%;border:3rpx solid var(--accent);display:flex;align-items:center;justify-content:center;font-size:36rpx;background:var(--bg3);box-shadow:0 0 12rpx var(--glow2)}
.lv-badge{font-size:22rpx;color:var(--accent);font-weight:700;background:var(--glow3);padding:6rpx 16rpx;border-radius:20rpx;border:2rpx solid var(--glow4)}
.coin{font-size:24rpx;color:var(--gold);font-weight:700;display:flex;align-items:center;gap:4rpx}
.energy{font-size:24rpx;color:var(--fire);font-weight:700;display:flex;align-items:center;gap:4rpx}

/* ===== 主题切换 ===== */
.theme-picker{position:relative}
.theme-btn{width:64rpx;height:64rpx;border-radius:50%;border:3rpx solid var(--accent);background:transparent;display:flex;align-items:center;justify-content:center;font-size:30rpx;box-shadow:0 0 12rpx var(--glow2)}
.theme-panel{position:absolute;top:84rpx;right:0;background:var(--bg2);border:2rpx solid var(--border);border-radius:28rpx;padding:32rpx;display:none;z-index:200;min-width:520rpx;box-shadow:0 16rpx 64rpx rgba(0,0,0,0.5)}
.theme-panel.open{display:block}
.theme-dots{display:flex;gap:24rpx;justify-content:center;flex-wrap:wrap}
.theme-dot-wrap{display:flex;flex-direction:column;align-items:center}
.theme-dot{width:72rpx;height:72rpx;border-radius:50%;border:5rpx solid transparent;transition:all .2s}
.theme-dot.active{border-color:var(--text);box-shadow:0 0 24rpx var(--accent)}
.theme-dot-label{font-size:22rpx;color:var(--text3);text-align:center;margin-top:8rpx}
.theme-section-label{font-size:24rpx;color:var(--text3);text-align:center;margin:16rpx 0 8rpx;font-weight:600;letter-spacing:2rpx}

/* ===== TabBar（加大触摸区域） ===== */
.tab-bar{position:fixed;bottom:0;left:0;width:100%;z-index:100;display:flex;justify-content:space-around;padding:16rpx 0 env(safe-area-inset-bottom);background:linear-gradient(0deg,var(--bar-bg),var(--bar-bg2));border-top:2rpx solid var(--border);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)}
.tab-item{display:flex;flex-direction:column;align-items:center;gap:6rpx;padding:12rpx 24rpx;position:relative;min-width:140rpx}
.tab-icon{font-size:52rpx;transition:all .25s}
.tab-label{font-size:22rpx;color:var(--text3);transition:all .25s}
.tab-item.active .tab-icon{transform:scale(1.15);filter:drop-shadow(0 0 12rpx var(--accent))}
.tab-item.active .tab-label{color:var(--accent);font-weight:700}
.tab-item.active::before{content:'';position:absolute;top:-2rpx;left:50%;transform:translateX(-50%);width:56rpx;height:4rpx;background:var(--accent);border-radius:2rpx;box-shadow:0 0 16rpx var(--accent)}

/* ===== 页面容器（由 wx:if 控制显示，不再用 display:none/block） ===== */
.page{display:none}
.page.active{display:block}

/* ===== 通用卡片 ===== */
.card{background:var(--card);border:2rpx solid var(--border);border-radius:28rpx;padding:32rpx;margin-bottom:20rpx;position:relative;overflow:hidden}
.card::before{content:'';position:absolute;top:0;left:0;right:0;height:2rpx;background:linear-gradient(90deg,transparent,var(--glow),transparent)}
.card-title{font-size:30rpx;font-weight:700;color:var(--text);margin-bottom:24rpx;display:flex;align-items:center;gap:12rpx}
.card-title .emoji{font-size:34rpx}

/* ===== 冒险地图页 ===== */
.map-decos{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:0}
.map-deco{position:absolute;border-radius:50%;background:var(--accent)}
.map-container{position:relative;margin:-16rpx -28rpx 0;padding:0 0 0}
.map-canvas-wrap{position:relative;width:100%;height:0;padding-bottom:120%}
.map-canvas{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none}
.map-nodes{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none}
.map-lines{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:1}
.map-line{position:absolute;height:0;border-top:2rpx dashed rgba(255,255,255,0.15);transform-origin:0 0}
.map-line.cleared{border-top:2rpx dashed rgba(255,255,255,0.45);box-shadow:0 0 8rpx rgba(255,255,255,0.15)}

/* 浅色主题连线颜色 */
[data-theme="dawn"] .map-line,
[data-theme="mint"] .map-line,
[data-theme="lavender"] .map-line,
[data-theme="snow"] .map-line{border-top-color:rgba(0,0,0,0.15)}
[data-theme="dawn"] .map-line.cleared,
[data-theme="mint"] .map-line.cleared,
[data-theme="lavender"] .map-line.cleared,
[data-theme="snow"] .map-line.cleared{border-top-color:rgba(0,0,0,0.35);box-shadow:none}
.map-node{position:absolute;width:104rpx;height:104rpx;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:auto;transition:all .25s;z-index:2}
.map-node.cleared{background:#2e7d32;border:3rpx solid #66bb6a;box-shadow:0 0 20rpx rgba(102,187,106,0.3)}
.map-node.current{background:#e65100;border:3rpx solid var(--fire);box-shadow:0 0 28rpx rgba(255,109,0,0.5);animation:pulse 1.5s infinite}
.map-node.locked{background:var(--bg3);border:3rpx solid rgba(255,255,255,0.08);opacity:0.5}
.map-node .node-day{font-size:22rpx;font-weight:700;color:#fff}
.map-node .node-stars{font-size:20rpx;letter-spacing:-4rpx}
@keyframes pulse{0%,100%{box-shadow:0 0 32rpx rgba(255,109,0,0.5)}50%{box-shadow:0 0 56rpx rgba(255,109,0,0.8)}}
.map-player{position:absolute;z-index:3;font-size:52rpx;transition:all .6s cubic-bezier(.4,0,.2,1);filter:drop-shadow(0 3rpx 6rpx rgba(0,0,0,0.5))}

.map-info{padding:20rpx;margin-top:-8rpx}
.map-chapter{font-size:34rpx;font-weight:700;color:var(--accent);margin-bottom:4rpx;display:block}
.map-subtitle{font-size:26rpx;color:var(--text2);margin-bottom:16rpx;display:block}

/* 今日关卡卡 */
.stage-card{background:rgba(255,109,0,0.1);border:2rpx solid rgba(255,109,0,0.3);border-radius:32rpx;padding:24rpx;margin-bottom:16rpx;position:relative;overflow:hidden}
.stage-card::after{content:'';position:absolute;top:-60rpx;right:-60rpx;width:160rpx;height:160rpx;background:radial-gradient(circle,rgba(255,109,0,0.15),transparent);border-radius:50%}

/* 今日装备列表 */
.today-equip-list{display:flex;flex-direction:column;gap:12rpx;margin-top:12rpx}
.today-equip-item{display:flex;align-items:center;gap:16rpx;padding:16rpx 20rpx;background:rgba(255,255,255,0.05);border-radius:16rpx;border:1rpx solid rgba(255,255,255,0.08)}
.today-equip-icon{font-size:36rpx;width:48rpx;text-align:center}
.today-equip-name{font-size:28rpx;font-weight:600;flex:1;color:var(--text)}
.today-equip-buff{font-size:22rpx;color:var(--accent);padding:4rpx 12rpx;background:rgba(0,229,255,0.1);border-radius:8rpx}
.stage-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:24rpx}
.stage-name{font-size:34rpx;font-weight:700;color:var(--fire)}
.stage-tag{font-size:24rpx;color:var(--gold);background:rgba(255,215,64,0.12);padding:8rpx 24rpx;border-radius:16rpx;border:2rpx solid rgba(255,215,64,0.25)}
.stage-quests{display:flex;flex-direction:column;gap:16rpx}
.quest-item{display:flex;align-items:center;gap:20rpx;padding:20rpx 24rpx;background:var(--glow3);border-radius:20rpx;border:2rpx solid rgba(255,255,255,0.04);min-height:88rpx}
.quest-check{width:52rpx;height:52rpx;border-radius:14rpx;border:4rpx solid var(--text3);display:flex;align-items:center;justify-content:center;font-size:28rpx;transition:all .2s;flex-shrink:0}
.quest-check.done{background:var(--accent2);border-color:var(--accent2);color:#fff}
.quest-text{flex:1}
.quest-name{font-size:28rpx;font-weight:600;display:block}
.quest-reward{font-size:24rpx;color:var(--gold);display:block}
.quest-progress{width:140rpx;height:16rpx;background:rgba(255,255,255,0.08);border-radius:8rpx;overflow:hidden;flex-shrink:0}
.quest-progress-fill{height:100%;border-radius:8rpx;transition:width .5s}

/* ===== 状态面板页 ===== */
.hud-panel{text-align:center;padding-top:16rpx}
.char-wrap{position:relative;display:inline-block;margin-bottom:24rpx}
.char-avatar{width:176rpx;height:176rpx;border-radius:50%;background:var(--bg3);border:6rpx solid var(--accent);display:flex;align-items:center;justify-content:center;font-size:96rpx;box-shadow:0 0 48rpx var(--glow2);position:relative;z-index:1}
.char-ring{position:absolute;top:-12rpx;left:-12rpx;right:-12rpx;bottom:-12rpx;border-radius:50%;border:6rpx solid transparent;border-top-color:var(--accent);animation:spin 3s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.char-lv{position:absolute;bottom:-8rpx;left:50%;transform:translateX(-50%);background:var(--accent);color:#fff;font-size:24rpx;font-weight:700;padding:6rpx 28rpx;border-radius:20rpx;white-space:nowrap;z-index:2}
.char-name{font-size:34rpx;font-weight:700;margin-bottom:4rpx;display:block}
.char-exp{font-size:26rpx;color:var(--text2);margin-bottom:32rpx;display:block}

/* 状态条（加粗） */
.stat-bars{display:flex;flex-direction:column;gap:24rpx;margin-bottom:0}
.stat-row{display:flex;align-items:center;gap:16rpx}
.stat-icon{width:52rpx;text-align:center;font-size:32rpx}
.stat-info{flex:1}
.stat-head{display:flex;justify-content:space-between;margin-bottom:8rpx}
.stat-label{font-size:24rpx;font-weight:600}
.stat-val{font-size:24rpx;color:var(--text2)}
.stat-bar{height:20rpx;background:rgba(255,255,255,0.08);border-radius:10rpx;overflow:hidden;position:relative}
.stat-fill{height:100%;border-radius:10rpx;position:relative;transition:width .8s cubic-bezier(.4,0,.2,1)}
.stat-fill.hp{background:#d32f2f;box-shadow:0 0 16rpx rgba(255,82,82,0.4)}
.stat-fill.mp{background:#1565c0;box-shadow:0 0 16rpx rgba(68,138,255,0.4)}
.stat-fill.exp{background:#2e7d32;box-shadow:0 0 16rpx rgba(105,240,174,0.4)}
.stat-fill.fiber{background:#6a1b9a;box-shadow:0 0 16rpx rgba(171,71,188,0.4)}

/* Buff/Debuff（加大） */
.buffs{display:flex;gap:16rpx;flex-wrap:wrap;margin-bottom:0;justify-content:center}

/* 营养趋势折线图 */
.chart-legend{display:flex;gap:24rpx;margin-bottom:16rpx;flex-wrap:wrap}
.chart-legend-item{font-size:22rpx;color:var(--text2);display:flex;align-items:center;gap:6rpx}
.chart-dot{width:16rpx;height:16rpx;border-radius:50%}
.trend-canvas{width:100%;height:400rpx;pointer-events:none}
.buff-tag{font-size:24rpx;padding:10rpx 24rpx;border-radius:20rpx;display:flex;align-items:center;gap:6rpx;font-weight:600}
.buff-tag.good{background:rgba(105,240,174,0.12);color:var(--exp);border:2rpx solid rgba(105,240,174,0.25)}
.buff-tag.warn{background:rgba(255,152,0,0.12);color:#ffb74d;border:2rpx solid rgba(255,152,0,0.25)}
.buff-tag.bad{background:rgba(255,82,82,0.12);color:var(--hp);border:2rpx solid rgba(255,82,82,0.25)}

/* 属性六边形 */
.attr-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16rpx;margin-bottom:0}
.attr-item{background:var(--glow3);border-radius:20rpx;padding:24rpx 12rpx;text-align:center;border:2rpx solid rgba(255,255,255,0.04)}
.attr-icon{font-size:44rpx;margin-bottom:4rpx;display:block}
.attr-name{font-size:22rpx;color:var(--text2);margin-bottom:4rpx;display:block}
.attr-val{font-size:34rpx;font-weight:800;color:var(--accent);display:block}
.attr-bar{height:10rpx;background:rgba(255,255,255,0.08);border-radius:5rpx;margin-top:8rpx;overflow:hidden}
.attr-bar-fill{height:100%;border-radius:5rpx}

/* ===== 宝箱商店页 ===== */
.shop-header{text-align:center;margin-bottom:32rpx}
.shop-title{font-size:38rpx;font-weight:800;background:linear-gradient(90deg,var(--gold),var(--fire));-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:8rpx;display:block}
.shop-sub{font-size:26rpx;color:var(--text2);display:block}

/* 稀有度 */
.rarity-common{border-color:rgba(158,158,158,0.3)}
.rarity-rare{border-color:rgba(68,138,255,0.4);box-shadow:0 0 24rpx rgba(68,138,255,0.15)}
.rarity-epic{border-color:rgba(171,71,188,0.4);box-shadow:0 0 24rpx rgba(171,71,188,0.15)}
.rarity-legend{border-color:rgba(255,109,0,0.4);box-shadow:0 0 32rpx rgba(255,109,0,0.2);background:rgba(255,109,0,0.08)}

.food-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin-bottom:28rpx}
.food-card{background:var(--card);border:3rpx solid var(--border);border-radius:24rpx;padding:28rpx 20rpx;text-align:center;transition:all .25s;position:relative;overflow:hidden;min-height:240rpx}
.food-card:active{transform:scale(0.96)}
.food-card .food-emoji{font-size:80rpx;margin-bottom:12rpx;display:block}
.food-card .food-name{font-size:28rpx;font-weight:700;margin-bottom:4rpx;display:block}
.food-card .food-desc{font-size:22rpx;color:var(--text2);margin-bottom:12rpx;display:block}
.food-rarity{font-size:22rpx;font-weight:700;padding:6rpx 20rpx;border-radius:12rpx;display:inline-block}
.rarity-common .food-rarity{background:rgba(158,158,158,0.15);color:var(--text3)}
.rarity-rare .food-rarity{background:rgba(68,138,255,0.15);color:var(--mp)}
.rarity-epic .food-rarity{background:rgba(171,71,188,0.15);color:#ce93d8}
.rarity-legend .food-rarity{background:rgba(255,109,0,0.15);color:var(--fire)}
.food-rarity-lg{font-size:26rpx;padding:8rpx 28rpx}

/* 横版补给卡片（战斗补给推荐） */
.food-row{display:flex;flex-direction:column;gap:16rpx;margin-bottom:28rpx}
.food-card-h{display:flex;align-items:center;gap:20rpx;padding:20rpx 24rpx;border-radius:20rpx;border:3rpx solid var(--border);background:var(--card);transition:all .25s;min-height:96rpx}
.food-card-h:active{transform:scale(0.98)}
.food-emoji-h{font-size:52rpx;flex-shrink:0;width:64rpx;text-align:center}
.food-info-h{flex:1;min-width:0}
.food-name-h{font-size:28rpx;font-weight:700;display:block;color:var(--text)}
.food-desc-h{font-size:22rpx;color:var(--text2);display:block;margin-top:2rpx}
.food-rarity-h{font-size:22rpx;font-weight:700;padding:6rpx 16rpx;border-radius:10rpx;flex-shrink:0}
.food-card-h-common{border-color:rgba(158,158,158,0.3)}
.food-card-h-common .food-rarity-h{background:rgba(158,158,158,0.15);color:var(--text3)}
.food-card-h-rare{border-color:rgba(68,138,255,0.4);box-shadow:0 0 16rpx rgba(68,138,255,0.1)}
.food-card-h-rare .food-rarity-h{background:rgba(68,138,255,0.15);color:var(--mp)}
.food-card-h-epic{border-color:rgba(171,71,188,0.4);box-shadow:0 0 16rpx rgba(171,71,188,0.1)}
.food-card-h-epic .food-rarity-h{background:rgba(171,71,188,0.15);color:#ce93d8}
.food-card-h-legend{border-color:rgba(255,109,0,0.4);box-shadow:0 0 24rpx rgba(255,109,0,0.15);background:rgba(255,109,0,0.06)}
.food-card-h-legend .food-rarity-h{background:rgba(255,109,0,0.15);color:var(--fire)}

/* 宝箱（加大触摸区域） */
.chest-area{text-align:center;margin-bottom:28rpx}
.chest{width:240rpx;height:240rpx;margin:0 auto 24rpx;position:relative;transition:transform .3s}
.chest:active{transform:scale(0.92)}
.chest-body{width:192rpx;height:144rpx;background:#8d6e63;border-radius:16rpx 16rpx 8rpx 8rpx;position:absolute;bottom:20rpx;left:24rpx;border:4rpx solid #a1887f}
.chest-lid{width:208rpx;height:72rpx;background:#a1887f;border-radius:16rpx 16rpx 0 0;position:absolute;bottom:160rpx;left:16rpx;border:4rpx solid #bcaaa4;transition:transform .4s;transform-origin:bottom}
.chest-lock{width:40rpx;height:40rpx;background:var(--gold);border-radius:50%;position:absolute;bottom:140rpx;left:100rpx;z-index:2;box-shadow:0 0 16rpx rgba(255,215,64,0.5)}
.chest.open .chest-lid{transform:rotateX(-60deg);transform-origin:bottom}
.chest-glow{position:absolute;top:0;left:50%;transform:translateX(-50%);width:140rpx;height:140rpx;background:radial-gradient(circle,rgba(255,215,64,0.3),transparent);border-radius:50%;opacity:0;transition:opacity .3s}
.chest.open .chest-glow{opacity:1}
.chest-label{font-size:28rpx;font-weight:700;color:var(--gold);margin-top:16rpx;display:block}

/* 每日特供 */
.daily-special{background:rgba(255,215,64,0.06);border:2rpx solid rgba(255,215,64,0.25);border-radius:28rpx;padding:28rpx;margin-bottom:28rpx}
.daily-special .card-title{color:var(--gold)}

/* AI 技能推荐 */
.ai-plan{padding:28rpx;background:var(--glow3);border-radius:20rpx;margin-bottom:20rpx;border:2rpx solid}
.ai-plan-title{font-size:28rpx;font-weight:700;margin-bottom:12rpx;display:block}
.ai-plan-desc{font-size:26rpx;color:var(--text2);margin-bottom:16rpx;display:block}
.ai-plan-tags{display:flex;gap:16rpx;flex-wrap:wrap}
.ai-tag{padding:12rpx 24rpx;border-radius:16rpx;font-size:24rpx}

/* ===== 冒险者档案页 ===== */
.profile-banner{background:var(--accent2);border-radius:32rpx;padding:48rpx 32rpx;text-align:center;margin-bottom:28rpx;position:relative;overflow:hidden}
.profile-banner::before{content:'';position:absolute;top:-80rpx;right:-80rpx;width:240rpx;height:240rpx;background:rgba(255,255,255,0.1);border-radius:50%}
.profile-avatar{width:152rpx;height:152rpx;border-radius:50%;background:var(--glow3);border:6rpx solid rgba(255,255,255,0.3);display:inline-flex;align-items:center;justify-content:center;font-size:84rpx;margin-bottom:16rpx;position:relative}
.profile-name{font-size:38rpx;font-weight:800;color:#fff;margin-bottom:4rpx;display:block}
.profile-title{font-size:26rpx;color:rgba(255,255,255,0.7);margin-bottom:28rpx;display:block}
.profile-stats{display:flex;justify-content:center;gap:48rpx}
.profile-stat{text-align:center}
.profile-stat-num{font-size:38rpx;font-weight:800;color:#fff;display:block}
.profile-stat-label{font-size:24rpx;color:rgba(255,255,255,0.6);display:block}

/* 属性面板 */
.attrs-panel{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin-bottom:28rpx}
.attr-card{background:var(--card);border:2rpx solid var(--border);border-radius:24rpx;padding:28rpx;text-align:center}
.attr-card .attr-icon{font-size:52rpx;display:block}
.attr-card .attr-name{font-size:24rpx;color:var(--text2);display:block}
.attr-card .attr-val{font-size:44rpx;font-weight:800;margin:4rpx 0;display:block}
.attr-card .attr-bar{height:10rpx;background:rgba(255,255,255,0.08);border-radius:5rpx;overflow:hidden;margin-top:8rpx}
.bmi-row{text-align:center;margin-top:8rpx}
.bmi-label{font-size:26rpx;color:var(--text2)}
.bmi-val{font-size:30rpx;font-weight:700;color:var(--accent)}
.bmi-status{font-size:24rpx;margin-left:8rpx}

/* 成就收集 */
.ach-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16rpx}
.ach-slot{background:var(--card);border:2rpx solid var(--border);border-radius:20rpx;padding:20rpx 8rpx;text-align:center;position:relative}
.ach-slot.locked{opacity:0.35;filter:grayscale(1)}
.ach-slot .ach-icon{font-size:52rpx;display:block;margin-bottom:4rpx}
.ach-slot .ach-name{font-size:22rpx;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block}
.ach-slot.unlocked .ach-icon{filter:drop-shadow(0 0 8rpx rgba(255,215,64,0.5))}
.ach-slot.unlocked{border-color:rgba(255,215,64,0.3)}

/* 装备栏（加大） */
.equip-row{display:flex;gap:16rpx;margin-bottom:0;justify-content:center}
.equip-slot{width:128rpx;height:128rpx;background:var(--card);border:3rpx dashed var(--border);border-radius:24rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:all .2s}
.equip-slot.filled{border-style:solid;border-color:var(--glow4)}
.equip-slot .eq-icon{font-size:48rpx;display:block}
.equip-slot .eq-label{font-size:22rpx;color:var(--text3);margin-top:4rpx;display:block}

/* 功能菜单（加大触摸区域） */
.menu-list{display:flex;flex-direction:column;gap:4rpx}
.menu-row{display:flex;align-items:center;gap:24rpx;padding:28rpx 24rpx;background:var(--card);border-radius:20rpx;transition:all .2s;border:2rpx solid transparent;min-height:96rpx}
.menu-row:active{background:var(--bg3);border-color:var(--border)}
.menu-icon{font-size:44rpx;width:72rpx;text-align:center}
.menu-text{flex:1}
.menu-name{font-size:28rpx;font-weight:600;display:block}
.menu-desc{font-size:24rpx;color:var(--text3);display:block}
.menu-arrow{color:var(--text3);font-size:32rpx}

/* 底部文字 */
.footer-text{text-align:center;padding:32rpx 0;font-size:24rpx;color:var(--text3);display:block}

/* ===== 模态框（加大关闭按钮和主按钮） ===== */
.modal-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.7);z-index:200;display:none;align-items:center;justify-content:center;padding:32rpx}
.modal-overlay.show{display:flex}
.modal{background:var(--bg2);border:2rpx solid var(--border);border-radius:36rpx;padding:48rpx 40rpx;width:100%;max-width:720rpx;max-height:80vh;overflow-y:auto;position:relative}
.modal-close{position:absolute;top:24rpx;right:24rpx;width:64rpx;height:64rpx;border-radius:50%;background:rgba(255,255,255,0.06);color:var(--text2);font-size:36rpx;display:flex;align-items:center;justify-content:center;z-index:10}
.modal-title{font-size:34rpx;font-weight:700;margin-bottom:32rpx;display:flex;align-items:center;gap:12rpx}

/* 菜品详情 */
.food-detail-center{text-align:center;margin-bottom:32rpx}
.food-detail-emoji{font-size:136rpx;display:block;margin-bottom:16rpx}
.food-nutrition-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16rpx;margin-bottom:28rpx}
.food-nut-item{text-align:center;padding:20rpx;border-radius:16rpx}
.food-nut-label{font-size:22rpx;color:var(--text3);display:block}
.food-nut-val{font-size:32rpx;font-weight:700;display:block}
.food-detail-desc-box{padding:24rpx;background:rgba(124,77,255,0.08);border-radius:16rpx;margin-bottom:28rpx;border:2rpx solid rgba(124,77,255,0.15)}
.food-detail-desc{font-size:26rpx;color:var(--accent2);display:block}

/* 属性/状态详情弹窗 */
.detail-icon{font-size:40rpx;margin-right:8rpx}
.detail-content-box{padding:28rpx;background:var(--glow3);border-radius:20rpx;border:2rpx solid var(--border)}
.detail-content{font-size:28rpx;color:var(--text);line-height:1.8;display:block}

/* 表单（加大输入框和按钮） */
.form-group{margin-bottom:28rpx}
.form-label{font-size:26rpx;color:var(--text2);margin-bottom:10rpx;display:block}
.form-input{width:100%;padding:24rpx 28rpx;background:var(--glow3);border:2rpx solid var(--border);border-radius:20rpx;color:var(--text);font-size:30rpx;min-height:88rpx;box-sizing:border-box}
.form-input:focus{border-color:var(--accent)}
.form-row{display:flex;gap:16rpx}
.form-row .form-group{flex:1}
/* 主按钮（加大高度确保触摸友好） */
.btn{padding:28rpx 48rpx;border-radius:24rpx;border:none;font-size:30rpx;font-weight:700;width:100%;text-align:center;min-height:96rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box}
.btn-primary{background:var(--accent2);color:#fff;box-shadow:0 0 32rpx var(--glow2)}
.btn-primary:active{transform:scale(0.97)}
/* 选项芯片（加大触摸区域） */
.toggle-group{display:flex;flex-wrap:wrap;gap:16rpx}
.toggle-chip{padding:16rpx 32rpx;border-radius:20rpx;font-size:26rpx;background:rgba(255,255,255,0.04);border:2rpx solid var(--border);color:var(--text2);min-height:72rpx;display:flex;align-items:center;box-sizing:border-box}
.toggle-chip.active{background:var(--glow3);border-color:var(--accent);color:var(--accent)}

/* 过敏提示 */
.allergy-hint{font-size:26rpx;color:var(--text2);margin-bottom:20rpx;display:block}

/* 开关（加大） */
.switch-row{display:flex;justify-content:space-between;align-items:center;padding:20rpx 0;min-height:88rpx}
.switch-label{font-size:28rpx}
.switch{width:100rpx;height:56rpx;border-radius:28rpx;background:rgba(255,255,255,0.1);position:relative;transition:background .2s}
.switch.on{background:var(--accent)}
.switch::after{content:'';width:48rpx;height:48rpx;border-radius:50%;background:#fff;position:absolute;top:4rpx;left:4rpx;transition:left .2s}
.switch.on::after{left:48rpx}

/* BMI */
.bmi-display{text-align:center;margin:32rpx 0}
.bmi-big-val{font-size:80rpx;font-weight:900;display:block}
.bmi-status-text{font-size:28rpx;font-weight:700;display:block}
.bmi-bar{height:20rpx;border-radius:10rpx;background:linear-gradient(90deg,#448aff,#69f0ae,#ffd740,#ff6d00,#ff5252);margin:20rpx 0 8rpx;position:relative}
.bmi-pointer{width:28rpx;height:28rpx;border-radius:50%;background:#fff;border:4rpx solid var(--bg1);position:absolute;top:-4rpx;transition:left .5s;box-shadow:0 0 12rpx rgba(255,255,255,0.5)}
.bmi-labels{display:flex;justify-content:space-between;font-size:22rpx;color:var(--text3)}

/* Toast */
.toast{position:fixed;top:120rpx;left:50%;transform:translateX(-50%);background:var(--accent2);color:#fff;padding:24rpx 52rpx;border-radius:24rpx;font-size:28rpx;font-weight:600;z-index:300;opacity:0;transition:opacity .3s;pointer-events:none;box-shadow:0 8rpx 40rpx rgba(124,77,255,0.4);white-space:nowrap}
.toast.show{opacity:1}
