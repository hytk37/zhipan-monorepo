.login-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #07C160 0%, #06ad54 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.login-box {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 48rpx;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,.12);
  text-align: center;
}

.login-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.login-subtitle {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.login-error {
  background: #fff0f0;
  color: #e74c3c;
  font-size: 26rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.field {
  margin-bottom: 28rpx;
  text-align: left;
  position: relative;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.field-input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 30rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 30rpx;
  background: #fafafa;
  box-sizing: border-box;
}

.field-input:focus {
  border-color: #07C160;
  background: #fff;
}

.toggle-pwd {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  font-size: 32rpx;
  padding: 8rpx;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #07C160, #06ad54);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  margin-top: 16rpx;
  border: none;
}

.login-btn[disabled] {
  opacity: .6;
}

.login-hint {
  margin-top: 36rpx;
  font-size: 24rpx;
  color: #bbb;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
