# ============================================
# 智慧膳系统 · 数据库配置
# 复制为 .env 后按实际环境修改；.env 不要提交到 git
# ============================================

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zhipan_canteen
DB_TIMEZONE=+08:00
DB_POOL_SIZE=10

# 生成种子数据时的规模（默认 4000 名学生、30 天营养汇总、7 天用餐明细）
SEED_STUDENTS=4000
SEED_DAYS_SUMMARY=30
SEED_DAYS_MEALS=7
