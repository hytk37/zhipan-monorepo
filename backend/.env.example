# ============================================
# 智慧膳系统 · 数据库配置
# 复制为 .env 后按实际环境修改；.env 不要提交到 git
# ============================================

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zhipan_canteen
DB_TIMEZONE=+08:00
DB_POOL_SIZE=10

# 生成种子数据时的规模（默认 4000 名学生、30 天营养汇总、7 天用餐明细）
SEED_STUDENTS=4000
SEED_DAYS_SUMMARY=30
SEED_DAYS_MEALS=7

# ============================================
# AI 能力（DeepSeek）
#
# ⚠️⚠️⚠️ 注意：本文件（.env.example）是「示例文件」，会被提交到 GitHub！
#   千万不要把真实 Key 填在这里 —— 一旦提交，Key 就泄露了，
#   GitHub 还会直接拒绝推送（push protection）。
#
#   ✅ 正确做法：把本文件复制一份、改名为 .env（去掉 .example），
#      再把 Key 填到 .env 里。.env 已被 .gitignore 忽略，不会上传。
#
#       cd backend
#       copy .env.example .env        (Windows)
#       cp .env.example .env          (macOS / Linux)
#
#   不填 Key 也能跑：所有 AI 接口会自动降级为规则模板，页面不会报错。
# ============================================

# 【留空即可】真实 Key 请填到 .env，不要填在这里
DEEPSEEK_API_KEY=

# 接口地址（一般不用改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型：flash 用于识别/翻译/文案，pro 用于复杂推理（如周菜单编排）
AI_MODEL_FLASH=deepseek-flash
AI_MODEL_PRO=deepseek-v4-pro

# 单次请求超时（毫秒）与失败重试次数
AI_TIMEOUT_MS=25000
AI_MAX_RETRIES=1

# 同时进行的最大请求数（开学高峰防限流）
AI_MAX_CONCURRENCY=4

# 每日 token 预算，超出后非核心 AI 功能自动降级（0 表示不限制）
AI_DAILY_TOKEN_BUDGET=800000

# 总开关：设为 false 可一键关闭全部 AI（接口走降级模板）
AI_ENABLED=true

# 调试用：设为 true 时即使填了 Key 也走降级模板（便于离线演示）
AI_MOCK=false

# ============================================
# 演示模式（嘉宾扫码体验）
# ============================================

# 对外访问地址，决定二维码里写的是什么地址。
# 留空时自动判断：
#   · 部署在 Koyeb → 自动使用平台注入的 KOYEB_PUBLIC_DOMAIN（公网 HTTPS）
#   · 部署在 Render → 自动使用平台注入的 RENDER_EXTERNAL_URL（公网 HTTPS）
#   · 本地运行 → 自动探测局域网 IP（如 http://192.168.0.215:3000）
# 需要手动指定（例如套了域名/内网穿透）时再填，如 https://demo.example.com
PUBLIC_BASE_URL=

