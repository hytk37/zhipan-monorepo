# ============================================
# 智慧膳系统 · 数据库配置
# 复制为 .env 后按实际环境修改；.env 不要提交到 git
# ============================================

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zhipan_canteen
DB_TIMEZONE=+08:00
DB_POOL_SIZE=10

# 生成种子数据时的规模（默认 4000 名学生、30 天营养汇总、7 天用餐明细）
SEED_STUDENTS=4000
SEED_DAYS_SUMMARY=30
SEED_DAYS_MEALS=7

# ============================================
# AI 能力（DeepSeek）
# 把下面的 Key 换成你自己的即可启用；不填则所有 AI 接口自动走规则模板降级，
# 页面依然有内容、不会报错。
# ============================================

# 【必填】在 https://platform.deepseek.com/api_keys 申请
DEEPSEEK_API_KEY=

# 接口地址（一般不用改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型：flash 用于识别/翻译/文案，pro 用于复杂推理（如周菜单编排）
AI_MODEL_FLASH=deepseek-flash
AI_MODEL_PRO=deepseek-v4-pro

# 单次请求超时（毫秒）与失败重试次数
AI_TIMEOUT_MS=25000
AI_MAX_RETRIES=1

# 同时进行的最大请求数（开学高峰防限流）
AI_MAX_CONCURRENCY=4

# 每日 token 预算，超出后非核心 AI 功能自动降级（0 表示不限制）
AI_DAILY_TOKEN_BUDGET=800000

# 总开关：设为 false 可一键关闭全部 AI（接口走降级模板）
AI_ENABLED=true

# 调试用：设为 true 时即使填了 Key 也走降级模板（便于离线演示）
AI_MOCK=false

