<!-- 背景层：粒子画布 + 地图装饰 -->
<!-- 由 pages/game/game.wxml 拆分而来（第 4-14 行） -->

  <!-- 粒子画布 -->
  <canvas type="2d" id="particles" class="particles-canvas" disable-scroll></canvas>

  <!-- 地图装饰（根级，position:fixed 在 scroll-view 内有兼容问题） -->
  <view class="map-decos" wx:if="{{currentTab === 0}}">
    <view class="map-deco" style="top:15%;left:5%;width:120rpx;height:120rpx;opacity:0.04"></view>
    <view class="map-deco" style="top:30%;right:10%;width:160rpx;height:160rpx;opacity:0.03"></view>
    <view class="map-deco" style="bottom:25%;left:20%;width:100rpx;height:100rpx;opacity:0.05"></view>
    <view class="map-deco" style="top:50%;left:50%;width:80rpx;height:80rpx;opacity:0.03"></view>
    <view class="map-deco" style="bottom:40%;right:15%;width:140rpx;height:140rpx;opacity:0.04"></view>
  </view>
