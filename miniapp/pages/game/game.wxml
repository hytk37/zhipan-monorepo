<!-- 智慧膳系统-冒险 · 营养闯关 - 页面骨架
     结构按区块拆到 ./templates/ 下；<include> 是原地展开，数据作用域与拆分前完全一致：
       particles.wxml   背景粒子画布 + 地图装饰
       nav-bar.wxml     自定义导航栏 + 主题切换
       tab-map / tab-status / tab-shop / tab-profile   四个 Tab 内容
       tabbar.wxml      底部 TabBar
       modals.wxml      7 个模态框
       toast.wxml       轻提示
-->
<view class="app" data-theme="{{currentTheme}}" style="{{themeStyle}}">

  <include src="./templates/particles.wxml" />

  <include src="./templates/nav-bar.wxml" />

  <!-- ===== 可滚动内容区（Flex:1, 每个 Tab 一个 scroll-view） ===== -->
  <view class="app-body" style="padding-top:{{navBarHeight}}px">

    <include src="./templates/tab-map.wxml" />

    <include src="./templates/tab-status.wxml" />

    <include src="./templates/tab-shop.wxml" />

    <include src="./templates/tab-profile.wxml" />

  </view><!-- .app-body -->

  <include src="./templates/tabbar.wxml" />

  <include src="./templates/modals.wxml" />

  <include src="./templates/toast.wxml" />
</view>
