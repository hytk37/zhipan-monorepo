<!-- pages/profile/profile.wxml -->
<view class="page-profile">

  <!-- 头部信息区 -->
  <view class="profile-header">
    <view class="header-bg"></view>
    <view class="profile-main">
      <view class="avatar-wrap" bindtap="editProfile">
        <view class="avatar">{{userInfo.avatar || '🧑‍🎓'}}</view>
        <view class="edit-badge">✏️</view>
      </view>
      <view class="user-name">{{userInfo.name}}</view>
      <view class="user-id">{{userInfo.id}} · {{userInfo.college}}
        <text wx:if="{{userInfo.gender === '非二元'}}" style="font-size:11px;color:#7c3aed;margin-left:6px;">· 非二元</text>
      </view>
      <view class="user-badges">
        <text class="badge-item">BMI {{userInfo.bmi}}</text>
        <text class="badge-item">目标：{{userInfo.goal}}</text>
        <text class="badge-item badge-diet" wx:if="{{userInfo.diet && userInfo.diet !== '无限制'}}">{{userInfo.diet}}</text>
      </view>

      <view class="stats-row">
        <view class="stat-item">
          <view class="stat-num">{{userInfo.checkDays}}</view>
          <view class="stat-label">打卡天数</view>
        </view>
        <view class="stat-item">
          <view class="stat-num">{{userInfo.avgScore}}</view>
          <view class="stat-label">平均评分</view>
        </view>
        <view class="stat-item">
          <view class="stat-num">Lv.{{userInfo.level}}</view>
          <view class="stat-label">营养等级</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 等级进度 -->
  <view class="card">
    <view class="card-title">
      <text>🏅 {{levelInfo.name}}</text>
      <text class="more" wx:if="{{levelInfo.needDays > 0}}">距{{levelInfo.nextLevel}}还需{{levelInfo.needDays}}天</text>
      <text class="more" wx:else>已满级！</text>
    </view>
    <view class="progress-bar level-bar">
      <view class="progress-fill level-fill" style="{{levelInfo.progressStyle}}"></view>
    </view>
    <view class="level-text">{{levelInfo.progress}}% 进度</view>
  </view>

  <!-- 本周打卡 -->
  <view class="card">
    <view class="card-title">
      <text>📅 本周打卡</text>
      <text class="more">已打{{weekCheckCount}}天</text>
    </view>
    <view class="week-row">
      <view class="week-day {{weekCheck[index] ? 'checked' : ''}}" wx:for="{{weekDays}}" wx:key="*this">
        <text class="day-label">{{item}}</text>
        <view class="day-dot">
          <text wx:if="{{weekCheck[index]}}">✓</text>
          <text wx:else class="dot-empty"></text>
        </view>
      </view>
    </view>
  </view>

  <!-- 成就墙 -->
  <view class="card">
    <view class="card-title">
      <text>🏆 成就墙</text>
      <text class="more">{{achievementUnlockedCount}}/{{achievements.length}}</text>
    </view>
    <view class="achievement-grid">
      <view
        class="ach-item {{item.unlocked ? '' : 'locked'}}"
        wx:for="{{achievements}}"
        wx:key="name"
        bindtap="showAchievement"
        data-index="{{index}}"
      >
        <view class="ach-icon">{{item.icon}}</view>
        <view class="ach-name">{{item.name}}</view>
        <view class="ach-lock" wx:if="{{!item.unlocked}}">🔒</view>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-card">
    <view
      class="menu-item"
      wx:for="{{menus}}"
      wx:key="title"
      bindtap="onMenuTap"
      data-url="{{item.url}}"
    >
      <view class="menu-left">
        <text class="menu-icon">{{item.icon}}</text>
        <view class="menu-text">
          <text class="menu-title">{{item.title}}</text>
          <text class="menu-desc">{{item.desc}}</text>
        </view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <!-- 过敏源提醒 -->
  <view class="card" wx:if="{{userInfo.allergyList.length > 0}}">
    <view class="card-title">
      <text>⚠️ 我的过敏源</text>
      <text class="more" bindtap="onMenuTap" data-url="/pages/settings/settings?type=allergy">管理</text>
    </view>
    <view class="allergy-tags">
      <text class="allergy-tag" wx:for="{{userInfo.allergyList}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="allergy-tip">智慧膳系统会在推荐菜品时自动排除含过敏源的菜品</view>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text>智慧膳系统 v2.0</text>
    <text>健康饮食 · 智慧校园</text>
  </view>

  <view style="height: 40rpx;"></view>
</view>
