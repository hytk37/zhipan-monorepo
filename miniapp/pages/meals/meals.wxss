/* pages/meals/meals.wxss */
.page-meals { min-height: 100vh; padding-bottom: calc(100rpx + env(safe-area-inset-bottom, 0)); }

/* 搜索栏 */
.search-bar { padding: 16rpx 24rpx 0; }
.search-wrap {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 100rpx;
  padding: 14rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.search-icon { font-size: 28rpx; margin-right: 12rpx; }
.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #333;
  border: none;
  background: transparent;
}

/* 统计卡片 */
.stats-card { margin-top: 16rpx; }
.week-range { font-size: 20rpx; color: #999; font-weight: 400; text-align: right; }
.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 12rpx 0;
}
.stat-item { text-align: center; flex: 1; }
.stat-num { font-size: 44rpx; font-weight: 700; line-height: 1.2; }
.stat-label { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.stat-divider { width: 1rpx; height: 60rpx; background: #EEEEEE; }

/* 记录列表 */
.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
  margin-bottom: 12rpx;
}
.record-date { display: flex; align-items: baseline; gap: 8rpx; flex: 1; min-width: 0; }
.date-text { font-size: 30rpx; font-weight: 600; color: #333; }
.weekday-text { font-size: 24rpx; color: #999; }
/* 与下方 .meal-cal 同宽，保证「评分」和「热量」两列右边缘对齐 */
.record-score { display: flex; align-items: baseline; justify-content: flex-end; flex-shrink: 0; min-width: 116rpx; white-space: nowrap; }
.score-num { font-size: 36rpx; font-weight: 700; }
.score-unit { font-size: 22rpx; color: #999; margin-left: 4rpx; }

/* 餐次列表 */
.meal-list { margin-bottom: 12rpx; }
.meal-row {
  display: flex;
  align-items: flex-start;      /* 菜名换行时表情/热量与首行对齐 */
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F8F8F8;
}
.meal-row:last-child { border-bottom: none; }
.meal-emoji { font-size: 40rpx; margin-right: 16rpx; flex-shrink: 0; line-height: 1.35; }
/* min-width:0 是关键：flex 子项默认 min-width:auto，长菜名会把右侧热量列顶出卡片，
   造成数字与菜名重叠；加上后文本才能在列内换行/省略 */
.meal-info { flex: 1; min-width: 0; }
.meal-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}
.meal-type { font-size: 26rpx; font-weight: 600; color: #333; }
.meal-time { font-size: 22rpx; color: #999; }
/* 菜名最多两行，超出省略；不再用 nowrap 单行截断，避免看不到吃了什么 */
.meal-items {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}
.meal-cal {
  text-align: right;
  flex-shrink: 0;
  min-width: 116rpx;
  padding-left: 16rpx;
  white-space: nowrap;
}
.cal-num { font-size: 28rpx; font-weight: 600; color: #FF9500; }
.cal-unit { font-size: 20rpx; color: #999; margin-left: 2rpx; }

/* 合计行 */
.record-footer {
  display: flex;
  justify-content: space-between;
  padding-top: 12rpx;
  border-top: 1rpx solid #F0F0F0;
}
.total-label { font-size: 24rpx; color: #999; }
.total-cal { font-size: 26rpx; font-weight: 600; color: #FF9500; }

/* AI 周分析入口条 */
.ai-bar{display:flex;align-items:center;gap:20rpx;margin:20rpx 24rpx 0;padding:24rpx 26rpx;
  border-radius:24rpx;background:linear-gradient(135deg,#16305A,#0B1B33)}
.ai-bar-badge{width:64rpx;height:64rpx;border-radius:18rpx;background:#07C160;color:#fff;
  font-size:26rpx;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.ai-bar-body{flex:1;min-width:0}
.ai-bar-title{font-size:29rpx;font-weight:600;color:#fff}
.ai-bar-sub{font-size:22rpx;color:#8AA8CC;margin-top:6rpx}
.ai-bar-arrow{color:#4FD8B0;font-size:40rpx;line-height:1;flex-shrink:0}
