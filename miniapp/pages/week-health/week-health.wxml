<!-- 智慧膳系统 · 本周饮食健康分析（AI 交互页） -->
<view class="page">

  <!-- AI 能力条 -->
  <view class="ai-banner">
    <view class="ai-badge">AI</view>
    <view class="ai-banner-text">
      <text class="ai-banner-title">本周饮食健康分析</text>
      <text class="ai-banner-sub">{{sourceLabel}}<block wx:if="{{week}}"> · {{week}}</block></text>
    </view>
    <view class="ai-refresh" bindtap="onRefresh">{{refreshing ? '分析中' : '重新分析'}}</view>
  </view>

  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <text>正在读取本周用餐记录并生成分析…</text>
  </view>

  <!-- 错误 -->
  <view class="err-card" wx:elif="{{error}}">
    <text class="err-text">{{error}}</text>
    <view class="btn-primary" bindtap="onRetry">重新加载</view>
  </view>

  <block wx:else>
    <!-- 评分总览 -->
    <view class="card score-card">
      <view class="score-head">
        <view class="score-num-wrap">
          <text class="score-num">{{score}}</text>
          <text class="score-unit">分</text>
        </view>
        <view class="score-meta">
          <view class="lv-tag {{levelClass}}">{{level}}</view>
          <text class="score-week">{{student.name}} · {{dateRange}}</text>
          <text class="score-sub">目标：{{student.goalType}}<block wx:if="{{student.diet}}"> · {{student.diet}}</block></text>
        </view>
      </view>
      <view class="score-track">
        <view class="score-fill" style="{{scoreRing}}"></view>
      </view>
      <view class="metric-row">
        <view class="metric-item">
          <text class="metric-v">{{avg.cal}}</text>
          <text class="metric-l">热量 /{{targets.cal}}</text>
        </view>
        <view class="metric-item">
          <text class="metric-v">{{avg.protein}}</text>
          <text class="metric-l">蛋白 /{{targets.protein}}g</text>
        </view>
        <view class="metric-item">
          <text class="metric-v">{{avg.fat}}</text>
          <text class="metric-l">脂肪 /{{targets.fat}}g</text>
        </view>
        <view class="metric-item">
          <text class="metric-v">{{avg.fiber}}</text>
          <text class="metric-l">纤维 /{{targets.fiber}}g</text>
        </view>
      </view>
    </view>

    <!-- AI 总结 -->
    <view class="card">
      <view class="card-title">
        <text>AI 整体评价</text>
        <text class="tag-ai">{{source === 'ai' ? 'AI 生成' : '规则模板'}}</text>
      </view>
      <text class="summary-text">{{summary}}</text>
      <view class="warn-note" wx:if="{{usageText}}">{{usageText}}</view>

      <!-- 亮点 -->
      <view class="sub-block" wx:if="{{aiHighlights.length}}">
        <view class="sub-title">做得好的地方</view>
        <view class="hl-item" wx:for="{{aiHighlights}}" wx:key="title">
          <text class="hl-dot"></text>
          <view class="hl-body">
            <text class="hl-t">{{item.title}}</text>
            <text class="hl-d">{{item.detail}}</text>
          </view>
        </view>
      </view>

      <!-- 问题与建议 -->
      <view class="sub-block" wx:if="{{aiProblems.length}}">
        <view class="sub-title">需要改进的地方</view>
        <view class="pb-item" wx:for="{{aiProblems}}" wx:key="title">
          <view class="pb-head">
            <text class="pb-t">{{item.title}}</text>
          </view>
          <text class="pb-d">{{item.detail}}</text>
          <view class="pb-sug">
            <text class="pb-sug-label">建议</text>
            <text class="pb-sug-text">{{item.suggestion}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 逐餐点评 -->
    <view class="card" wx:if="{{mealComments.length}}">
      <view class="card-title"><text>按菜品逐餐点评</text></view>
      <view class="mc-item" wx:for="{{mealComments}}" wx:key="index">
        <view class="mc-head">
          <text class="mc-date">{{item.date}}</text>
          <text class="mc-meal">{{item.meal}}</text>
        </view>
        <text class="mc-text">{{item.comment}}</text>
      </view>
    </view>

    <!-- 每日明细 -->
    <view class="card" wx:if="{{daily.length}}">
      <view class="card-title"><text>本周逐日营养</text></view>
      <view class="day-item" wx:for="{{daily}}" wx:key="date">
        <view class="day-head">
          <text class="day-name">{{item.weekday}}</text>
          <text class="day-cal">{{item.cal}} kcal · 纤维 {{item.fiber}}g</text>
        </view>
        <view class="day-bars">
          <view class="bar-row">
            <text class="bar-label">热量</text>
            <view class="bar-track"><view class="bar-fill" style="{{item.calW}}"></view></view>
          </view>
          <view class="bar-row">
            <text class="bar-label">蛋白</text>
            <view class="bar-track"><view class="bar-fill" style="{{item.proteinW}}"></view></view>
          </view>
          <view class="bar-row">
            <text class="bar-label">脂肪</text>
            <view class="bar-track"><view class="bar-fill" style="{{item.fatW}}"></view></view>
          </view>
          <view class="bar-row">
            <text class="bar-label">纤维</text>
            <view class="bar-track"><view class="bar-fill" style="{{item.fiberW}}"></view></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 行动建议 -->
    <view class="card" wx:if="{{advice.length}}">
      <view class="card-title"><text>下周可以这样做</text></view>
      <view class="adv-item" wx:for="{{advice}}" wx:key="index">
        <text class="adv-no">{{index + 1}}</text>
        <text class="adv-text">{{item}}</text>
      </view>
    </view>

    <!-- 追问对话 -->
    <view class="card">
      <view class="card-title">
        <text>追问 AI</text>
        <text class="tag-ai">基于你的真实数据</text>
      </view>

      <view class="quick-row">
        <view class="quick-chip" data-q="我这周脂肪为什么偏高？" bindtap="onAskQuick">脂肪为什么偏高</view>
        <view class="quick-chip" data-q="我想补膳食纤维，食堂有哪些菜可以选？" bindtap="onAskQuick">怎么补纤维</view>
        <view class="quick-chip" data-q="我下周该怎么吃？" bindtap="onAskQuick">下周怎么吃</view>
      </view>

      <scroll-view class="chat-list" scroll-y scroll-into-view="{{scrollTo}}" wx:if="{{messages.length}}">
        <view class="msg {{item.role === 'user' ? 'msg-user' : 'msg-ai'}}" wx:for="{{messages}}" wx:key="id" id="{{item.id}}">
          <view class="msg-bubble">
            <text class="msg-text">{{item.text}}</text>
            <text class="msg-tag" wx:if="{{item.tag}}">{{item.tag}}</text>
          </view>
        </view>
        <view id="msg-bottom" style="height:1rpx"></view>
      </scroll-view>
      <view class="chat-empty" wx:else>
        <text>有疑问可以直接问，比如「我这周脂肪为什么偏高」</text>
      </view>

      <view class="chat-input-row">
        <input class="chat-input" value="{{input}}" placeholder="问点关于你这周饮食的问题…"
               confirm-type="send" bindinput="onInput" bindconfirm="onSend" />
        <view class="chat-send {{sending ? 'chat-send-disabled' : ''}}" bindtap="onSend">
          {{sending ? '…' : '发送'}}
        </view>
      </view>
    </view>

    <!-- 拍照记一餐 -->
    <view class="card">
      <view class="card-title"><text>记账式补充：拍照识别一餐</text></view>
      <text class="hint-text">拍一张餐盘照片，AI 识别菜品后自动算营养并写入本周记录（识别结果同样会过你的饮食禁忌过滤）。</text>
      <view class="btn-primary" bindtap="onPhotoMeal">拍照识别并记入</view>
    </view>

    <view class="foot-note">{{disclaimer}}</view>
  </block>
</view>
