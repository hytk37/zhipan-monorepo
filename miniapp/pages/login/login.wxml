<view class="login-page">
  <view class="login-box">
    <view class="login-icon">🥗</view>
    <view class="login-title">智膳系统</view>
    <view class="login-subtitle">营养分析与AI推荐系统</view>

    <view class="login-error" wx:if="{{errorMsg}}">{{errorMsg}}</view>

    <view class="field">
      <text class="field-label">账号</text>
      <input class="field-input" type="text" placeholder="输入学号或账号..." value="{{account}}" bindinput="onAccountInput" />
    </view>

    <view class="field">
      <text class="field-label">密码</text>
      <input wx:if="{{!showPwd}}" class="field-input" type="password" placeholder="输入密码..." value="{{password}}" bindinput="onPwdInput" />
      <input wx:else class="field-input" type="text" placeholder="输入密码..." value="{{password}}" bindinput="onPwdInput" />
      <text class="toggle-pwd" bindtap="togglePwd">{{showPwd ? '🙈' : '👁️'}}</text>
    </view>

    <button class="login-btn" bindtap="handleLogin" disabled="{{loading}}">
      <text wx:if="{{loading}}">⏳ 登录中...</text>
      <text wx:else>登 录</text>
    </button>

    <view class="login-hint">
      <text>默认密码: 123456</text>
      <text>请联系管理员获取账号</text>
    </view>
  </view>
</view>
